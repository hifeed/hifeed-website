# Salin ke .env.local lalu isi. Jangan commit .env.local.

# URL publik situs (canonical, OG, sitemap)
NEXT_PUBLIC_SITE_URL=https://hifeed.co
NEXT_PUBLIC_GSC_VERIFICATION=

# Form konsultasi → Slack
SLACK_WEBHOOK_URL=

# ── Sanity CMS ─────────────────────────────────────────────
# Kosong = website memakai konten bawaan (src/i18n/dictionaries.ts).
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Opsional; default 2025-01-01
NEXT_PUBLIC_SANITY_API_VERSION=
# Secret yang sama dengan webhook Sanity → /api/revalidate
SANITY_REVALIDATE_SECRET=
# Hanya untuk `npm run sanity:seed` (token role Editor). Jangan dipasang di Vercel.
SANITY_API_WRITE_TOKEN=
